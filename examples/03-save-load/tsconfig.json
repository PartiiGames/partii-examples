{
  "compilerOptions": {
    "target": "ES2022",
    // KEEP THIS false. With true (the default for ES2022+ targets), a field declared without a value
    // (`body!: Phaser.Physics.Arcade.Body`, `sprite?: Sprite`) is re-set to undefined AFTER the base
    // class constructor assigned it. Phaser arcade bodies vanish, with no error. Rocket to Heaven lost
    // its physics this way. test/starter.test.ts compiles a class both ways to show it.
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@partii/sdk": ["./partii-sdk/client.ts"],
      "@partii/sdk/*": ["./partii-sdk/*.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
