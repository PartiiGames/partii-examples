# Partii production: copy to .env.production, then fill in your own game's id and its production publishable key
# (partii keys create). `npm run build:prod` refuses to build until the key is set and the API isn't staging.
# The motion runtime is loaded from this API too: ${VITE_PARTII_API}/_partii/motionii/0.1.0/
VITE_PARTII_API=https://api.partii.games
VITE_PARTII_KEY=
VITE_PARTII_GAME=
